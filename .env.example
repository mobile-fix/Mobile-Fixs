# ─────────────────────────────────────────────────────────────
# MyMobiFix — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string.
# On Render, use the *Internal* Database URL for the web service (same region,
# no egress, faster) and the External URL when connecting from your machine.
#   postgresql://user:password@host:5432/mymobifix?schema=public
DATABASE_URL=""

# ── Auth / Sessions ─────────────────────────────────────────
# REQUIRED. Min 32 characters. Signs the admin session JWT (HS256).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Session lifetime in seconds (default 28800 = 8 hours)
SESSION_MAX_AGE="28800"

# ── Seed / bootstrap admin ──────────────────────────────────
# Used ONLY by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL="admin@mymobifix.com"
SEED_ADMIN_PASSWORD="ChangeMe!2024"
SEED_ADMIN_NAME="MyMobiFix Admin"
# Set to "true" ONLY on a showcase environment. It generates fake customers,
# bookings and reviews. Leave unset in production — the seed then creates the
# device catalogue and the owner account and nothing else.
SEED_DEMO_DATA=""

# ── Public site config (safe to expose to the browser) ──────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="MyMobiFix"
NEXT_PUBLIC_SUPPORT_PHONE="+91 00000 00000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@mymobifix.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="910000000000"
NEXT_PUBLIC_BUSINESS_HOURS="Mon–Sat, 9:00 AM – 8:00 PM IST"
NEXT_PUBLIC_BUSINESS_ADDRESS="Placeholder Address, Sector 00, City 000000"
NEXT_PUBLIC_CURRENCY="INR"
# Set to "true" alongside SEED_DEMO_DATA so the site visibly labels its sample
# reviews and statistics as illustrative. Leave unset in production.
NEXT_PUBLIC_USES_DEMO_DATA=""

# ── Third-party integrations ────────────────────────────────
# All optional. When a key is absent the app degrades gracefully and the
# corresponding feature reports "not configured" instead of pretending to work.

# Google Maps embed (contact page map). Without it a styled placeholder renders.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Transactional email (booking confirmations). Provider-agnostic SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MyMobiFix <no-reply@mymobifix.com>"

# SMS / WhatsApp notifications (booking + status updates)
SMS_PROVIDER=""            # e.g. "twilio" | "msg91"
SMS_API_KEY=""
SMS_SENDER_ID=""
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Payments (deposits / prepaid repairs)
PAYMENT_PROVIDER=""        # e.g. "razorpay" | "stripe"
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=""

# ── Rate limiting ───────────────────────────────────────────
# In-memory by default. Set a Redis URL for multi-instance deployments.
RATE_LIMIT_REDIS_URL=""
